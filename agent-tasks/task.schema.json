{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-server task",
  "description": "One task in a task pack (<pack>/<name>.yaml). src/load-tasks.ts enforces the same rules at build and run time.",
  "type": "object",
  "required": ["name", "enabled", "tiers", "max_class", "budget", "params_schema", "output_schema", "prompt"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "description": "<pack>.<task>; must equal the file name without .yaml" },
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "tiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["free", "cheap", "standard", "deep"] }, "description": "allowed tiers; the first is the default" },
    "max_class": { "$ref": "#/$defs/class" },
    "min_class": { "$ref": "#/$defs/class" },
    "subscription": { "const": "owner_use", "description": "required for tiers whose route is owner_use_only" },
    "model": { "type": "string", "description": "overrides the tier's default model" },
    "tools": { "type": "array", "items": { "type": "string" }, "description": "tools the adapter may grant; [] = none" },
    "outputs": { "type": "array", "minItems": 1, "items": { "enum": ["inline", "git_pr", "r2"] } },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "budget": {
      "type": "object",
      "required": ["max_usd", "max_turns", "timeout_s"],
      "additionalProperties": false,
      "properties": {
        "max_usd": { "type": "number", "minimum": 0 },
        "max_turns": { "type": "integer", "minimum": 1 },
        "timeout_s": { "type": "integer", "minimum": 1 }
      }
    },
    "params_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "prompt": { "type": "string", "minLength": 1, "description": "{{param}} placeholders; non-string values are JSON-encoded" }
  },
  "$defs": { "class": { "enum": ["public", "internal", "phi"] } }
}
