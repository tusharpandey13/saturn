{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saturn.research_crossref/v1",
  "title": "Research cross-reference (JSON sidecar of docs/health/<ns>/research/YYYY-MM-DD-crossref.md)",
  "description": "Method: docs/methods/research-crossref.md. Checked by tools/research/verify_citations.py. Record and flag only: associations, never causation; no diagnosis; no dose advice.",
  "type": "object",
  "required": ["schema", "ns", "run_date", "data_as_of", "disclaimer", "summary", "red_flags", "items", "questions", "search_log", "revisit", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "saturn.research_crossref/v1" },
    "ns": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "person namespace from records.yaml; never a name" },
    "run_date": { "type": "string", "format": "date" },
    "data_as_of": { "type": "string", "format": "date", "description": "latest fact date in the KB views read" },
    "focus": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "previous": { "type": ["string", "null"], "description": "path of the prior cross-reference this one revisits" },
    "disclaimer": { "const": "Facts as written; not advice; doctors decide." },
    "summary": { "type": "string", "maxLength": 1200 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["view"], "additionalProperties": false,
        "properties": { "view": { "type": "string" }, "rows": { "type": "integer", "minimum": 0 } }
      }
    },
    "red_flags": {
      "type": "array",
      "description": "Recorded findings that match a red-flag rule. Escalate to urgent care now; never researched.",
      "items": {
        "type": "object", "required": ["what", "kb_ids", "escalation"], "additionalProperties": false,
        "properties": {
          "what": { "type": "string" },
          "kb_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kb_id" } },
          "escalation": { "enum": ["emergency-now", "same-day-doctor"] }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "statement", "kb_ids", "evidence", "applicability", "citations", "for_clinician", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^rx-[0-9]{3}$", "description": "local to this run" },
          "type": { "enum": ["association", "interaction", "label_fact", "lab_interference", "monitoring_gap", "signal"] },
          "statement": { "type": "string", "maxLength": 600, "description": "neutral, sourced; 'is associated with', 'the label states'" },
          "kb_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kb_id" }, "description": "the person's facts this item is about" },
          "evidence": {
            "type": "object", "required": ["design", "certainty"], "additionalProperties": false,
            "properties": {
              "design": { "enum": ["guideline", "systematic_review", "rct", "cohort", "case_control", "case_series", "expert_opinion", "label", "reference_text"] },
              "certainty": { "enum": ["high", "moderate", "low", "very_low", "not_graded"], "description": "GRADE as stated by the source; not_graded if the source gives none (never invented)" },
              "grade_as_printed": { "type": "string", "maxLength": 60, "description": "e.g. '1C', 'Class I, LOE A', 'practice point'" },
              "ocebm": { "enum": ["1", "2", "3", "4", "5", "n/a"] }
            }
          },
          "applicability": {
            "type": "object", "required": ["match", "notes"], "additionalProperties": false,
            "properties": {
              "match": { "enum": ["good", "partial", "poor", "unknown"] },
              "age": { "$ref": "#/$defs/dim" },
              "sex": { "$ref": "#/$defs/dim" },
              "comorbidity": { "$ref": "#/$defs/dim" },
              "ancestry_region": { "$ref": "#/$defs/dim" },
              "setting": { "$ref": "#/$defs/dim", "description": "e.g. Indian availability, brands, lab methods" },
              "notes": { "type": "string", "maxLength": 400 }
            }
          },
          "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
          "for_clinician": { "type": "string", "maxLength": 120, "description": "a ref:party id or a role ('treating urologist'); never the agent" },
          "question_ids": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["new", "unchanged", "changed", "retired"], "description": "against the previous cross-reference" },
          "verification": { "enum": ["unverified", "agent", "human"], "default": "agent" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "text", "for_clinician", "item_ids"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:q:[0-9]{4}$", "description": "next free id in questions.md" },
          "text": { "type": "string", "maxLength": 400 },
          "for_clinician": { "type": "string", "maxLength": 120 },
          "item_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^rx-[0-9]{3}$" } },
          "priority": { "enum": ["next-visit", "routine"] }
        }
      }
    },
    "search_log": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["at", "source", "query", "hits", "kept"], "additionalProperties": false,
        "properties": {
          "at": { "type": "string", "description": "ISO date-time, IST" },
          "source": { "type": "string" },
          "query": { "type": "string", "description": "exactly as sent; no names, ids or dates of birth" },
          "filters": { "type": "string" },
          "hits": { "type": "integer", "minimum": 0 },
          "screened": { "type": "integer", "minimum": 0 },
          "kept": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "revisit": {
      "type": "object", "required": ["next_due", "triggers"], "additionalProperties": false,
      "properties": {
        "next_due": { "type": "string", "format": "date" },
        "triggers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "properties": { "ran_at": { "type": "string" }, "errors": { "type": "integer" }, "warnings": { "type": "integer" } }
    }
  },
  "$defs": {
    "kb_id": { "type": "string", "pattern": "^([a-z][a-z0-9-]*:(src|fact)|ref:(drug|code|party)):[a-z0-9.-]+$" },
    "dim": { "enum": ["match", "differs", "not_reported", "unknown"] },
    "citation": {
      "type": "object", "required": ["source_type", "quote", "accessed"], "anyOf": [{ "required": ["pmid"] }, { "required": ["doi"] }, { "required": ["url"] }],
      "additionalProperties": false,
      "properties": {
        "source_type": { "enum": ["guideline", "systematic_review", "primary_study", "label", "trial_registry", "reference_text"] },
        "pmid": { "type": "string", "pattern": "^[1-9][0-9]{0,8}$" },
        "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "version": { "type": "string", "description": "guideline year/edition or label revision date" },
        "locator": { "type": "string", "description": "section, recommendation number, table, page" },
        "quote": { "type": "string", "minLength": 1, "maxLength": 400, "description": "verbatim from the cited text" },
        "accessed": { "type": "string", "format": "date" }
      }
    }
  }
}
