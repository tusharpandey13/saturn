{
  "name": "saturn-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "TZ=UTC vitest run",
    "typecheck": "tsc --noEmit",
    "render": "tsx scripts/render.ts",
    "env:check": "tsx scripts/render.ts check",
    "batch": "tsx batch/run.ts",
    "db:migrate:local": "npm run render && npx wrangler d1 migrations apply DB --local",
    "e2e:local": "npm run render && node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "2.9.1"
  },
  "description": "Saturn ingest Worker and daily batch",
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "4.6.7"
  }
}
