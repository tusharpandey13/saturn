def claims_page(ns, display, claims, asof):
    b = [f"# Claims register: {display}", "", f"**{DISCLAIMER}**", "",
         f"_Generated by `tools/crossref` from the KB (data as of {ddmon(asof)}). Don't edit this page._", "",
         "Every condition recorded in a source and every family- or patient-reported statement, with who made it. The "
         "state describes the **records** (whether a later source restates the claim or records it differently); it is "
         "never a verdict on whether the claim is true.", ""]
    states = {}
    for c in claims:
        states[c["state"]] = states.get(c["state"], 0) + 1
    b += table(["state", "claims"], sorted(states.items())) + [""]
    b += table(["claim", "as written", "status as documented", "date", "asserted by", "author", "state", "later sources",
                "same-source facts"],
               [[f"`{c['id']}`", c["text_as_written"], c["status_as_documented"] or "", ddmon(c["at"]), c["asserted_by"],
                 c["author_name"] or "", c["state"] + (f" ({c['owner'].get('question') or c['owner'].get('answer')})"
                                                        if c.get("owner") and (c["owner"].get("question") or c["owner"].get("answer")) else ""),
                 "<br>".join(f"`{l['target']}` ({l['relation']})" for l in c["links"] if l["relation"] != "same-source"),
                 sum(1 for l in c["links"] if l["relation"] == "same-source")]
                for c in claims]) + [""]
    return b


# ---------------------------------------------------------------------------------------------------------- profile
def profile_page(ns, display, kb, h, cfg, checks, rows, feedback, claims, root, asof, today):
    """docs/health/<ns>/profile.md (design 3.3): problem-oriented running profile from home readings. Facts and
    statistics only; interpretation stays in the linked analysis notes."""
    t, week0, w28 = today.isoformat(), (today - datetime.timedelta(days=6)).isoformat(), \
        (today - datetime.timedelta(days=27)).isoformat()
    bs = {c["params"].get("series"): dict(BS_DEFAULTS, **c["params"]) for c in checks.values()
          if c["operator"] == "baseline_shift" and c["status"] == "active"}
    live = [(r, *flag_view(r, feedback, today)) for r in rows]
    shift = [(r, st) for r, st, _ in live if r["check"] in {c["id"] for c in checks.values()
                                                            if c["operator"] == "baseline_shift"}
             and st in ("open", "snoozed", "promoted")]
    pref = h["preferred"]
    b = [f"# Running profile: {display}", "", f"**{DISCLAIMER}**", "",
         f"_Generated by `tools/crossref` from home readings in the KB (data as of {ddmon(asof)}; week "
         f"{ddmon(week0)} to {ddmon(t)}). Don't edit this page._", "",
         "Home readings compared with this person's own recent readings, with ids. A band is this person's usual "
         "range, not a target. A steady series is not reassurance: home weight and BP trends miss many changes; "
         "symptoms and the doctors decide. Change flags are `routine` and appear in the weekly roll-up.", ""]
    # 1. problems
    conds = [c for c in claims if c["kind"] == "condition"]
    links = (cfg["problem_signals"] or {}).get(ns) or {}
    b += ["## 1. Problems as documented", "",
          f"{len(conds)} condition claim(s) on record: see [problems.md](problems.md) and [claims.md](claims.md).", ""]
    if links:
        byfact = {c["fact"]: c for c in conds}
        b += table(["problem (as written)", "status as documented", "date", "fact", "signals"],
                   [[byfact[f]["text_as_written"] if f in byfact else "(not an active condition fact)",
                     (byfact.get(f) or {}).get("status_as_documented") or "", ddmon((byfact.get(f) or {}).get("at", "")),
                     f"`{f}`", ", ".join(sr)] for f, sr in sorted(links.items())]) + [""]
    else:
        b += ["No problem-to-signal links set yet (`profile.problem_signals` in `data/meta/gen-views.json`, owner "
              "decision D3).", ""]
    # 2. signals
    b += ["## 2. Signals", "",
          f"Daily value = median of the day's home readings in the `{pref}` session"
          + ("" if pref == "any" else " (other sessions when that one has none: `mixed-session`)")
          + ". Band = median ± k × max(1.4826 × MAD, floor) of the baseline days (window minus the last days), "
            "shown once enough days exist.", ""]
    srows = []
    for s in hs.SERIES:
        days = h["daily"].get(s, {})
        if not days and s not in bs:
            continue
        wk = [days[d]["value"] for d in sorted(days) if week0 <= d <= t]
        nread = sum(days[d]["n"] for d in days if week0 <= d <= t)
        p = bs.get(s) or dict(BS_DEFAULTS, min_spread=0)
        band, status = None, "no data"
        past = {d: v for d, v in days.items() if d <= t}
        if past:
            anchor = datetime.date.fromisoformat(max(past))
            if (today - anchor).days >= p["window_days"]:
                status = f"no value in {p['window_days']} days"
            else:
                band = hs.baseline(past, anchor, p)
                if band["status"] != "ok":
                    status = f"warming-up ({band['n']}/{band['need']})"
                else:
                    pos = [hs.position(v["value"], band) for _, v in hs.recent(past, anchor, p)]
                    status = ", ".join(f"{pos.count(x)} {x}" for x in ("above", "within", "below") if pos.count(x)) \
                        + f" (last {p['recent_days']} days)"
        code = hs.SERIES_CODE[s]
        clinic = kb.q("SELECT t.at, t.id FROM v_trend t JOIN source s ON s.id = t.source_id WHERE t.ns = ? AND t.code = ? "
                      f"AND s.kind NOT IN ({','.join('?' * len(cfg['home_source_kinds']))}) "
                      "AND lower(coalesce(t.method, '')) NOT LIKE '%home%' ORDER BY t.at DESC LIMIT 1",
                      ns, f"ref:code:{code}", *cfg["home_source_kinds"])
        sd = f"{statistics.stdev(wk):.1f}" if len(wk) >= 3 else ""
        cv = f" (CV {statistics.stdev(wk) / statistics.mean(wk) * 100:.0f}%)" if s == "sbp" and len(wk) >= 3 else ""
        srows.append([f"{s}{'' if s in bs else ' (shown only)'}", f"`{hs.sparkline(past, today)}`",
                      f"{nread} / {len(wk)}", r1(statistics.median(wk)) if wk else "",
                      f"{r1(min(wk))}-{r1(max(wk))}" if wk else "", sd + cv,
                      f"{r1(band['lo'])}-{r1(band['hi'])} (median {r1(band['median'])}, n {band['n']}, {band['basis']})"
                      if band and band["status"] == "ok" else "", status,
                      f"{ddmon(clinic[0]['at'])} `{clinic[0]['id']}`" if clinic else ""])
    b += table(["series", f"last 28 days ({ddmon(w28)} to {ddmon(t)}; · = none)", "this week: readings / days",
                "median", "min-max", "SD", "band", "status", "latest clinic reading"], srows) + [""]
    show = sorted({d for s in h["daily"].values() for d in s if (today - datetime.timedelta(days=13)).isoformat() <= d <= t},
                  reverse=True)
    if show:
        g = lambda s, d: h["daily"].get(s, {}).get(d)
        cell = lambda s, d: r1(g(s, d)["value"]) if g(s, d) else ""
        drows = []
        for d in show:
            entries = [g(s, d) for s in ("sbp", "pulse", "weight") if g(s, d)]
            sess = sorted({x for e in entries for x in e["sessions"]})
            marks = sorted({e["mark"] for e in entries if e["mark"]})
            mt = sorted({e["med_timing"] for e in entries if e["med_timing"]})
            drows.append([ddmon(d), ", ".join(sess), f"{cell('sbp', d)}/{cell('dbp', d)}" if g("sbp", d) else "",
                          cell("pulse", d), cell("weight", d), max(e["n"] for e in entries),
                          ", ".join(mt) or "not stated", ", ".join(marks)])
        b += ["Daily values, last 14 days:", ""] + table(
            ["day", "session(s)", "BP", "pulse", "weight", "readings", "vs morning medicines", "marks"], drows) + [""]
    # 3. change flags
    b += ["## 3. Change flags", ""]
    if shift:
        b += table(["flag", "statement", "first seen", "state"],
                   [[f"`{r['id']}`", r["statement"], ddmon(r["first_seen"]), st] for r, st in shift]) + [""]
    else:
        b += ["No open `baseline-shift` flag.", ""]
    b += ["All flags: [flags.md](flags.md).", ""]
    # 4. symptoms
    sym = kb.q("SELECT t.at, t.id, coalesce(t.value_text, t.quote) AS what, s.kind FROM v_trend t JOIN fact f ON f.id = t.id "
               "JOIN source s ON s.id = t.source_id WHERE t.ns = ? AND json_extract(f.data, '$.category') = 'symptom' "
               "AND substr(t.at, 1, 10) BETWEEN ? AND ? ORDER BY t.at, t.id", ns, week0, t)
    b += ["## 4. Symptoms this week, as written", ""]
    b += (table(["day", "as written", "source kind", "fact"], [[ddmon(r["at"]), r["what"] or "", r["kind"], f"`{r['id']}`"]
                                                                for r in sym]) if sym else ["None recorded."]) + [""]
    # 5. alongside
    ctxr = kb.q("SELECT at, end_at, category, summary, id FROM v_context WHERE ns = ? AND end_at >= ? AND substr(at, 1, 10) <= ? "
                "ORDER BY at, id", ns, w28, t)
    meds, last = [], {}  # medicine changes only: a first statement, a stop, or a statement after a stop
    for r in kb.q("SELECT f.at, f.id, coalesce(json_extract(f.data, '$.brand'), json_extract(f.data, '$.drug_id')) AS drug, "
                  "coalesce(json_extract(f.data, '$.drug_id'), lower(json_extract(f.data, '$.brand'))) AS k, "
                  "json_extract(f.data, '$.status') AS st FROM fact f WHERE f.ns = ? AND f.kind = 'medication' AND "
                  "f.status = 'active' AND substr(f.at, 1, 10) <= ? ORDER BY f.at, f.id", ns, t):
        prev = last.get(r["k"])
        if r["at"][:10] >= w28 and (prev is None or r["st"] == "stopped" != prev or prev == "stopped" != r["st"]):
            meds.append(r)
        last[r["k"]] = r["st"]
    b += ["## 5. Alongside (last 28 days)", "", "Shown alongside, not as a cause.", ""]
    b += (table(["from", "to", "life context", "summary", "fact"], [[ddmon(r["at"]), ddmon(r["end_at"]), r["category"],
                                                                      r["summary"] or "", f"`{r['id']}`"] for r in ctxr])
          if ctxr else ["No life-context rows."]) + [""]
    b += (["Medicines started, stopped or restarted, as recorded:", ""] + table(["day", "medicine (as written)", "statement", "fact"], [[ddmon(r["at"]), r["drug"] or "", r["st"] or "",
                                                                         f"`{r['id']}`"] for r in meds])
          if meds else ["No medicine started, stopped or restarted in these days (as recorded)."]) + [""]
    # 6. data quality and sufficiency
    rd = h["readings"]
    timed = [r for r in rd if r["session"] != "untimed"]
    sess_n = {x: sum(1 for r in rd if r["session"] == x) for x in ("morning", "afternoon", "evening", "untimed")}
    pulse_src = {r["source"] for r in rd if r["code"] == "pulse"}
    no_pulse = [r for r in rd if r["code"] == "bp" and r["source"] not in pulse_src]
    unused = [r for r in rd if not r["used"]]
    mixed = sorted({d for s in h["daily"].values() for d, v in s.items() if v["mark"]})
    first = min((r["day"] for r in rd), default=None)
    b += ["## 6. Data sufficiency and quality", ""]
    suf = []
    for s in ("sbp", "pulse", "weight"):
        days = h["daily"].get(s, {})
        p = bs.get(s) or BS_DEFAULTS
        suf.append([s, sum(1 for d in days if week0 <= d <= t), sum(1 for d in days if w28 <= d <= t),
                    ddmon(min(days)) if days else "", ddmon(max(days)) if days else "",
                    f"{p['min_baseline_days']} baseline days + {p['recent_days']} recent"])
    b += table(["series", "days this week (of 7)", "days in 28", "first home day", "latest home day", "a band needs"],
               suf) + [""]
    b += [f"- Home readings: {len(rd)} ({len(rd) - len(unused)} used), first {ddmon(first) if first else 'none'}. "
          f"Sessions: morning {sess_n['morning']}, afternoon {sess_n['afternoon']}, evening {sess_n['evening']}, "
          f"untimed {sess_n['untimed']}"
          + (f"; timed readings between {min(r['at'][11:16] for r in timed)} and {max(r['at'][11:16] for r in timed)} IST"
             if timed else "") + ". Time is the message time unless the record states the reading time.",
          f"- Preferred session: `{pref}`. Mixed-session days: {len(mixed)}"
          + (f" ({', '.join(ddmon(d) for d in mixed)})" if mixed else "") + ".",
          f"- Before/after morning medicines stated on {sum(1 for r in rd if r['med_timing'])} reading(s).",
          f"- BP readings without a pulse in the same source: {len(no_pulse)}.",
          f"- Duplicates collapsed: {len(h['merges'])} (each counted once until a human confirms; listed below)."]
    if unused:
        b += [f"- Not used (low-confidence or open hard read; see [data-quality.md](data-quality.md)): "
              + ", ".join(f"`{r['id']}`" for r in unused) + "."]
    b += [""]
    if h["merges"]:
        b += table(["rule", "code", "kept", "counted once with"],
                   [[m["rule"], m["code"], f"`{m['kept']}` ({ddmon(m['kept_day'])})",
                     f"`{m['dropped']}` ({ddmon(m['dropped_day'])})"] for m in h["merges"]]) + [""]
    # 7. linked analyses
    paths = list((cfg["links"] or {}).get(ns) or [])
    base = root / "docs" / "log" / "analysis"
    if base.is_dir():
        found = sorted((x for x in base.rglob("*.md") if ns in x.name and x.name != "README.md"),
                       key=lambda x: x.name, reverse=True)
        paths += [str(x.relative_to(root)) for x in found[:5]]
    b += ["## 7. Linked analyses and inferences", "",
          "Offline notes and agent-inferred records; any interpretation stays in them, labelled as it is there.", ""]
    if (root / "docs" / "health" / ns / "status.md").exists():
        b += ["- [status.md](status.md) (agent-inferred records, `tools/inference`)"]
    b += [f"- [{x}](../../../{x})" for x in dict.fromkeys(paths)]
    b += ([] if b[-1].startswith("- ") else ["None."]) + [""]
    summary = dict(series=sum(1 for s in ("sbp", "pulse", "weight") if h["daily"].get(s)),
                   days=len({d for s in h["daily"].values() for d in s if week0 <= d <= t}),
                   flags=sorted({r["subject_key"].split("|")[4] for r, _ in shift}), merges=len(h["merges"]),
                   warming=sum(1 for x in srows if x[7].startswith("warming-up")))
    return b, summary


# ----------------------------------------------------------------------------------------------------------- digest
def digest_section(per_ns, display, feedback, today, cfg, first_run, claims_by_ns, profiles=None):
    out = []
    lines = []
    for ns, (shown, waiting, _) in per_ns.items():
        if shown or waiting:
            lines.append(display.get(ns, ns))
            lines += [f"• {r['statement']} [{r['id']}]" for r in shown]
            if waiting:
                lines.append(f"• {waiting} more waiting (cap {cfg['daily_cap']} a day); see docs/health/{ns}/flags.md")
    if first_run:
        n = sum(len(v[2]) for v in per_ns.values())
        out += ["", f"Cross-check (records only; {DISCLAIMER}):",
                f"First run: {n} flag(s) recorded as the baseline (not listed here). See docs/health/<member>/flags.md."]
    elif lines:
        out += ["", f"Cross-check flags, new (records only; questions for the doctor, not advice; {DISCLAIMER}). "
                    "Reply useful / noise / snooze / promote via crossref feedback:"] + lines
    if today.isoweekday() == cfg["rollup_weekday"]:
        week = (today - datetime.timedelta(days=7)).isoformat()
        roll = []
        for ns, (_, _, rows) in per_ns.items():
            live = [r for r in rows if flag_view(r, feedback, today)[0] in ("open", "snoozed", "promoted")]
            if not live and not claims_by_ns.get(ns):
                continue
            by = {s: sum(1 for r in live if r["severity"] == s) for s in SEVERITIES}
            new = sum(1 for r in rows if r["changed_at"] > week)
            cl = claims_by_ns.get(ns, [])
            moved = sum(1 for c in cl if c["state"] not in ("as-recorded",))
            roll.append(f"• {display.get(ns, ns)}: open next-visit {by['next-visit']}, routine {by['routine']}, "
                        f"data-quality {by['data-quality']}; new or changed this week {new}; claims {len(cl)} "
                        f"({moved} not as-recorded)")
        prec = precision([r for v in per_ns.values() for r in v[2]], feedback)
        voted = [f"{k.split(':')[-1]} {v['useful']}/{v['useful'] + v['noise']}" for k, v in sorted(prec.items())
                 if v["useful"] + v["noise"]]
        for ns, p in (profiles or {}).items():
            fl = f"{len(p['flags'])} change flag(s)" + (f" ({', '.join(p['flags'])})" if p["flags"] else "")
            roll.append(f"• {display.get(ns, ns)} profile: {p['series']} series, {p['days']}/7 days; {fl}; "
                        f"{p['merges']} duplicate(s) collapsed; {p['warming']} series warming up; "
                        f"see docs/health/{ns}/profile.md")
        if roll:
            out += ["", "Cross-check weekly roll-up:"] + roll
            out.append("• precision (useful/marked): " + (", ".join(voted) if voted else "no marks yet"))
    return "\n".join(out)


# -------------------------------------------------------------------------------------------------------------- run
def run(a):
    root = pathlib.Path(a.records).resolve()
    rc = records_config.load(root)
    db = pathlib.Path(a.db) if a.db else root / "data" / "kb.sqlite"
    if not db.exists():
        raise CrossrefError(f"{db} not found; run tools/kb/build --records {root} first")
    today = datetime.date.fromisoformat(a.today)
    checks = load_checks(root, seed=not a.dry_run)
    cfg = load_config(root)
    _, feedback = load_feedback(root)
    kb = KB(sqlite3.connect(f"file:{db}?mode=ro", uri=True))
    gv = root / "data" / "meta" / "gen-views.json"
    gvc = json.loads(gv.read_text(encoding="utf-8")) if gv.exists() else {}
    key_series = gvc.get("key_series", {})
    pcfg = hs.config(gvc)
    claims = build_claims(kb, feedback)
    home = {}

    def home_of(ns):
        if ns not in home:
            home[ns] = hs.v_home_daily(kb, pcfg, ns)
        return home[ns]
    profile_ns = [ns for ns in rc["persons"] if (pcfg["persons"] is None and home_of(ns)["readings"])
                  or ns in (pcfg["persons"] or [])]
    ctx = {"today": today, "persons": rc["persons"], "key_series": key_series, "claims": claims,
           "profile_ns": profile_ns, "home": home_of}
    found = []
    for chk in sorted(checks.values(), key=lambda c: c["id"]):
        if chk["status"] == "active":
            found += [(chk, it) for it in OPS[chk["operator"]](kb, chk, ctx)]
    fp, nfacts, asof = kb.fingerprint()
    digest_ok = a.dry_run or bool(a.digest and pathlib.Path(a.digest).exists())
    xdir = root / "crossref"
    per_ns, totals, changed_files = {}, {"new": 0, "changed": 0, "closed": 0, "reopened": 0}, []
    claims_by_ns, profiles = {}, {}
    for c in claims:
        claims_by_ns.setdefault(c["ns"], []).append(c)
    for ns in rc["namespaces"]:
        fpath = xdir / ns / "flags.ndjson"
        first = not fpath.exists()
        old = {r["subject_key"]: r for r in read_ndjson(fpath)}
        rows, n = update_flags(old, [(c, i) for c, i in found if i["ns"] == ns], checks, today, baseline=first)
        for k in totals:
            totals[k] += n[k]
        rows = sorted(rows.values(), key=lambda r: r["id"])
        # flags are picked for the digest only when there is a digest to carry them (a delayed batch run has none)
        shown, waiting = pick_digest(rows, feedback, today, cfg["daily_cap"] if digest_ok else 0)
        per_ns[ns] = (shown, waiting, rows)
        ns_claims = claims_by_ns.get(ns, [])
        if not a.dry_run:
            if rows or fpath.exists():
                changed_files += [fpath] if write_ndjson(fpath, rows) else []
            cpath = xdir / ns / "claims.ndjson"
            if ns_claims or cpath.exists():
                changed_files += [cpath] if write_ndjson(cpath, ns_claims) else []
        hdir = root / "docs" / "health" / ns
        if hdir.is_dir() and (rows or ns_claims):
            disp = rc["display"].get(ns, ns)
            if write_page(hdir / "flags.md", f"Cross-check flags ({ns})", [f"crossref/{ns}/flags.ndjson", "crossref/checks.ndjson"],
                          flags_page(ns, disp, rows, feedback, checks, asof, today), today, a.dry_run):
                changed_files.append(hdir / "flags.md")
            if ns_claims and write_page(hdir / "claims.md", f"Claims register ({ns})", [f"crossref/{ns}/claims.ndjson"],
                                        claims_page(ns, disp, ns_claims, asof), today, a.dry_run):
                changed_files.append(hdir / "claims.md")
        if hdir.is_dir() and ns in profile_ns:
            body, profiles[ns] = profile_page(ns, rc["display"].get(ns, ns), kb, home_of(ns), pcfg, checks, rows,
                                              feedback, ns_claims, root, asof, today)
            if write_page(hdir / "profile.md", f"Running profile ({ns})", [f"crossref/{ns}/flags.ndjson", "data/kb.sqlite"],
                          body, today, a.dry_run):
                changed_files.append(hdir / "profile.md")
    first_run = all(r.get("digest_day") == "baseline" for v in per_ns.values() for r in v[2]) and totals["new"] > 0 \
        and totals["new"] == sum(len(v[2]) for v in per_ns.values())
    digest = digest_section(per_ns, rc["display"], feedback, today, cfg, first_run, claims_by_ns, profiles)
    counts = {
        "run": f"run:{datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%MZ')}-l1",
        "day": today.isoformat(), "data_as_of": asof, "kb_fingerprint": fp[:16], "facts": nfacts, **totals,
        "open": {s: sum(1 for v in per_ns.values() for r in v[2]
                        if r["severity"] == s and flag_view(r, feedback, today)[0] == "open") for s in SEVERITIES},
        "flags": sum(len(v[2]) for v in per_ns.values()), "claims": len(claims),
        "digest_listed": sum(len(v[0]) for v in per_ns.values()),
        "checks_active": sorted(c["id"].split(":")[-1] for c in checks.values() if c["status"] == "active")}
    runs = xdir / "runs.ndjson"
    prev = read_ndjson(runs)[-1:] if runs.exists() else []
    if not a.dry_run and (changed_files or not prev or prev[0].get("kb_fingerprint") != counts["kb_fingerprint"]):
        runs.parent.mkdir(parents=True, exist_ok=True)
        with runs.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(counts, sort_keys=True) + "\n")
    if a.digest and digest and not a.dry_run:
        p = pathlib.Path(a.digest)
        if p.exists():
            with p.open("a", encoding="utf-8") as fh:
                prev_text = p.read_text(encoding="utf-8")
                fh.write(("\n" if prev_text and not prev_text.endswith("\n") else "") + digest.lstrip("\n") + "\n")
    # counts only on stdout (the batch log must carry no PHI)
    print("crossref: " + json.dumps({k: counts[k] for k in ("facts", "flags", "claims", "new", "changed", "closed",
                                                             "reopened", "open", "digest_listed")}, sort_keys=True))
    if a.dry_run and a.print_digest:
        print(digest)
    return 0


def feedback_cmd(a):
    root = pathlib.Path(a.records).resolve()
    records_config.load(root)
    t = a.target
    known = set()
    for f in (root / "crossref").glob("*/flags.ndjson"):
        known |= {r["id"] for r in read_ndjson(f)}
    for f in (root / "crossref").glob("*/claims.ndjson"):
        known |= {r["id"] for r in read_ndjson(f)}
    if t not in known:
        raise CrossrefError(f"feedback: unknown flag or claim id {t}")
    row = {"target": t, "action": a.action, "by": a.by,
           "at": a.at or datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=5, minutes=30))).isoformat(timespec="seconds")}
    for k in ("days", "question", "answer", "reason"):
        if getattr(a, k) is not None:
            row[k] = getattr(a, k)
    validate_feedback(row)
    path = root / "crossref" / "feedback.ndjson"
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    print(f"ok: {a.action} recorded for {t}; rerun crossref to refresh the pages")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--records", required=True)
    if "feedback" in argv:
        i = argv.index("feedback")
        argv = argv[:i] + argv[i + 1:]
        ap.add_argument("target")
        ap.add_argument("action", choices=FLAG_ACTIONS + CLAIM_ACTIONS)
        ap.add_argument("--days", type=int)
        ap.add_argument("--question")
        ap.add_argument("--answer")
        ap.add_argument("--reason")
        ap.add_argument("--by", default="owner")
        ap.add_argument("--at", help=argparse.SUPPRESS)
        fn = feedback_cmd
    else:
        ap.add_argument("--db")
        ap.add_argument("--today", default=datetime.date.today().isoformat())
        ap.add_argument("--digest", help="append the digest section to this file when it exists")
        ap.add_argument("--dry-run", action="store_true", help="write nothing")
        ap.add_argument("--print-digest", action="store_true", help="with --dry-run: print the digest section")
        fn = run
    a = ap.parse_args(argv)
    try:
        return fn(a)
    except (CrossrefError, records_config.RecordsError) as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
