def main(argv=None):
    ap = argparse.ArgumentParser(prog="stt", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("pending")
    p.add_argument("--records", required=True)
    t = sub.add_parser("transcribe")
    t.add_argument("audio")
    t.add_argument("--records", required=True)
    t.add_argument("--force", action="store_true", help="redo a .mac.transcript.md this tool wrote")
    t.add_argument("--no-reconcile", action="store_true")
    t.add_argument("--speakers", type=int, help="exact speaker count, when you know it")
    t.add_argument("--min-speakers", type=int, help="at least this many speakers (a call: 2)")
    t.add_argument("--max-speakers", type=int)
    r = sub.add_parser("run")
    r.add_argument("--records", required=True)
    r.add_argument("--limit", type=int, default=0)
    r.add_argument("--written", help="write the changed paths (relative to the records root) to this file")
    r.add_argument("--no-answers", action="store_true")
    r.add_argument("--no-eval", action="store_true")
    sub.add_parser("doctor")
    a = ap.parse_args(argv)
    return {"pending": cmd_pending, "transcribe": cmd_transcribe, "run": cmd_run, "doctor": cmd_doctor}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
