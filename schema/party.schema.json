{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ref.data for kind=party (organisation or practitioner). ref.name = name",
 "description": "credentials: as printed on documents (cited in `printed`) plus public-register checks (`verified`). Display only: never a ranking or an authority score (AGENTS.md section 6). qualification / reg_no are the older free-text fields, kept as written.",
 "type": "object",
 "properties": {
  "kind": {
   "enum": [
    "hospital",
    "lab",
    "clinic",
    "pharmacy",
    "practitioner",
    "other"
   ]
  },
  "qualification": {
   "type": "string"
  },
  "reg_no": {
   "type": "string"
  },
  "org_id": {
   "type": "string",
   "x-ref": "party"
  },
  "city": {
   "type": "string"
  },
  "state": {
   "type": "string"
  },
  "credentials": {
   "type": "object",
   "properties": {
    "name_as_printed": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "degrees": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "specialty": {
     "type": "string"
    },
    "role": {
     "type": "string"
    },
    "institution_id": {
     "type": "string",
     "x-ref": "party"
    },
    "registration": {
     "type": "object",
     "properties": {
      "number": {
       "type": "string"
      },
      "council": {
       "type": "string"
      },
      "as_printed": {
       "type": "string"
      }
     },
     "additionalProperties": false,
     "required": [
      "number"
     ]
    },
    "contact": {
     "type": "string"
    },
    "type": {
     "type": "string"
    },
    "city": {
     "type": "string"
    },
    "accreditation": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "body": {
        "type": "string"
       },
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "valid_to": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "level": {
        "type": "string"
       },
       "source_url": {
        "type": [
         "string",
         "null"
        ]
       },
       "checked_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "result": {
        "enum": [
         "matched",
         "not found",
         "mismatch",
         "not checked",
         "self-declared"
        ]
       },
       "note": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "body",
       "result",
       "checked_at"
      ]
     }
    },
    "printed": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "source_id": {
        "type": "string",
        "x-ref": "source"
       },
       "page": {
        "type": [
         "integer",
         "null"
        ]
       },
       "fields": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "quote": {
        "type": "string",
        "maxLength": 200
       }
      },
      "additionalProperties": false,
      "required": [
       "source_id",
       "fields",
       "quote"
      ]
     }
    },
    "verified": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "source_url": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "register",
         "institution",
         "secondary"
        ]
       },
       "checked_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "result": {
        "enum": [
         "matched",
         "not found",
         "mismatch",
         "not checked"
        ]
       },
       "states": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "source_url",
       "kind",
       "checked_at",
       "result"
      ]
     }
    },
    "verification_summary": {
     "enum": [
      "matched",
      "partial",
      "not found",
      "mismatch",
      "not checked"
     ]
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 },
 "additionalProperties": false,
 "required": [
  "kind"
 ]
}
