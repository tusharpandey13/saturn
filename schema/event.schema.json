{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "fact.data for kind=event (ADR 007). Visits/admissions (ADR 004 encounters) are events; other facts point at them with context_id",
 "type": "object",
 "properties": {
  "type": {
   "enum": [
    "opd",
    "admission",
    "teleconsult",
    "test_visit",
    "in_absentia",
    "home",
    "procedure",
    "travel",
    "fall",
    "missed_dose",
    "hospitalisation",
    "med-list-complete",
    "other"
   ]
  },
  "label": {
   "type": "string"
  },
  "end": {
   "type": "string"
  },
  "org_id": {
   "type": "string",
   "x-ref": "party"
  },
  "practitioner_id": {
   "type": "string",
   "x-ref": "party"
  },
  "reason_text": {
   "type": "string"
  },
  "detail": {
   "type": [
    "object",
    "string"
   ]
  },
  "drug_ids": {
   "type": "array",
   "items": {
    "type": "string",
    "x-ref": "drug"
   },
   "description": "med-list-complete only: every drug on the confirmed list"
  }
 },
 "additionalProperties": false,
 "required": [
  "type"
 ]
}
